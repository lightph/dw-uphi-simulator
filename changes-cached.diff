@@ -0,0 +1,265 @@
+import argparse
+import numpy as np
+import matplotlib.pyplot as plt
+from pathlib import Path
+
+def setup_prb_style():
+    """Configures matplotlib to match Physical Review B single-column style."""
+    plt.rcParams.update({
